{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlataChan/octopus-kb/schemas/cli/lint.json",
  "title": "Lint CLI output",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "path", "message"],
        "properties": {
          "code": {"type": "string"},
          "path": {"type": "string"},
          "message": {"type": "string"},
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ledger_status", "revision_id", "logical_document_id", "access_label"],
            "properties": {
              "ledger_status": {"type": "string"},
              "revision_id": {"type": ["string", "null"]},
              "logical_document_id": {"type": ["string", "null"]},
              "access_label": {"type": ["string", "null"]}
            }
          }
        }
      }
    }
  }
}
